# ── Required ──────────────────────────────────────────────────────────────────

# Anthropic API key (https://console.anthropic.com/settings/keys)
ANTHROPIC_API_KEY=sk-ant-...

# Notion integration token (https://www.notion.so/my-integrations)
NOTION_API_KEY=secret_...

# ID of the Notion database where digest pages will be created
# Copy from the database URL: notion.so/<workspace>/<DATABASE_ID>?v=...
NOTION_DATABASE_ID=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Shared secret used to authenticate requests from the web UI
# Choose any long random string, e.g.: openssl rand -hex 32
WEBHOOK_SECRET=change-me-to-a-long-random-secret

# Telegram bot token from @BotFather
TELEGRAM_BOT_TOKEN=123456789:ABCdef...

# Your Telegram user ID (send /start to your bot to get it)
TELEGRAM_ALLOWED_USER_ID=123456789

# ── Optional ──────────────────────────────────────────────────────────────────

# Whisper model size: tiny | base | small | medium | large
# Larger = more accurate but slower and more RAM. "base" is a good default.
WHISPER_MODEL=base

# Port the webhook server listens on (default: 8000)
PORT=8000

# Override default storage paths (relative to project root by default)
# DB_PATH=data/reels.db
# DOWNLOAD_DIR=data/downloads
